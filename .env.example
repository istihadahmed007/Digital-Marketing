# ==============================================================================
# NexusMark CRM & Marketing Platform — Environment Configuration Template
# Duplicate this file to .env.local and populate with your credentials.
# NOTE: Never commit .env.local or raw credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE & SUPABASE ARCHITECTURE (Required)
# ------------------------------------------------------------------------------
# Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon API Key (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Supabase Service Role Key (Used server-side for automated migrations/tests)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Application base URL (used for OAuth redirect callbacks)
NEXT_PUBLIC_SITE_URL=https://digi.vartualtutor.com

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC VAULT & SECRET STORAGE (Required for encrypted integrations)
# ------------------------------------------------------------------------------
# 32+ character random secret string used to derive the AES-256-GCM encryption key for secrets at rest
ENCRYPTION_SECRET=your-secure-32-byte-encryption-passphrase-here

# ------------------------------------------------------------------------------
# 3. EMAIL DELIVERY INFRASTRUCTURE — RESEND (Required for email campaigns)
# ------------------------------------------------------------------------------
# Resend API Key (starts with re_..., generated at https://resend.com/api-keys)
RESEND_API_KEY=

# Verified sender address (e.g. newsletter@yourverifieddomain.com or onboarding@resend.dev for test sandbox)
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 4. MARKETING AUTOMATION — MAUTIC INTEGRATION (Optional)
# ------------------------------------------------------------------------------
# Base URL of your Mautic instance (e.g. https://mautic.yourcompany.com)
MAUTIC_BASE_URL=

# Mautic API Public Key / Client ID (from Mautic Configuration -> API Settings)
MAUTIC_PUBLIC_KEY=

# Mautic API Secret Key / Password
MAUTIC_SECRET_KEY=

# Optional: Direct OAuth2 Bearer Access Token
MAUTIC_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 5. GOOGLE SEARCH CONSOLE & GOOGLE ANALYTICS 4 (Optional)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Access Token or Service Account token with Search Console readonly scope
GSC_ACCESS_TOKEN=

# Google OAuth 2.0 Access Token with Analytics readonly scope
GA4_ACCESS_TOKEN=

# Google OAuth Client Credentials (for automatic token refresh)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 6. SERP & BACKLINK PROVIDERS — DATAFORSEO & SERPAPI (Optional)
# ------------------------------------------------------------------------------
# DataForSEO API Login (email) and Password
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# SerpApi Key for live Google SERP rank queries (from https://serpapi.com)
SERPAPI_API_KEY=

# ------------------------------------------------------------------------------
# 7. AI GROWTH INTELLIGENCE — OPENAI & GEMINI (Optional)
# ------------------------------------------------------------------------------
# OpenAI API Key (starts with sk-..., from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# OpenAI Model identifier (e.g. gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (alternative AI provider, from https://aistudio.google.com)
GEMINI_API_KEY=
