# ==============================================================================
# GrowthPilot AI — Production Marketing Automation Platform Configuration
# Duplicate this file to .env.local and populate with your credentials.
# NOTE: Never commit .env.local or raw credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE & SUPABASE ARCHITECTURE (Required)
# ------------------------------------------------------------------------------
# Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon API Key (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Supabase Service Role Key (Used server-side for automated migrations/tests)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Application base URL (used for OAuth redirect callbacks)
NEXT_PUBLIC_SITE_URL=https://digi.vartualtutor.com

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC VAULT & SECRET STORAGE (Required for encrypted integrations)
# ------------------------------------------------------------------------------
# 32+ character random secret string used to derive the AES-256-GCM encryption key for secrets at rest
ENCRYPTION_SECRET=your-secure-32-byte-encryption-passphrase-here

# ------------------------------------------------------------------------------
# 3. EMAIL DELIVERY INFRASTRUCTURE — RESEND & BREVO (Free-First Architecture)
# ------------------------------------------------------------------------------
# Resend API Key (starts with re_..., generated at https://resend.com/api-keys)
RESEND_API_KEY=

# Verified sender address (e.g. updates@yourverifieddomain.com or onboarding@resend.dev for test sandbox)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Brevo (formerly Sendinblue) API Key (alternative email provider with 300 free emails/day)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# ------------------------------------------------------------------------------
# 4. WORKFLOW AUTOMATION ENGINE — N8N COMMUNITY & MAUTIC (Self-Hosted Free)
# ------------------------------------------------------------------------------
# Self-hosted n8n Community Edition inbound webhook URL
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/growthpilot
N8N_API_KEY=

# Base URL of your Mautic instance (e.g. https://mautic.yourcompany.com)
MAUTIC_BASE_URL=
MAUTIC_PUBLIC_KEY=
MAUTIC_SECRET_KEY=
MAUTIC_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 5. GOOGLE SEARCH CONSOLE & GOOGLE ANALYTICS 4 (Telemetry & Rank Tracking)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Access Token or Service Account token with Search Console readonly scope
GSC_ACCESS_TOKEN=

# Google OAuth 2.0 Access Token with Analytics readonly scope
GA4_ACCESS_TOKEN=

# Google OAuth Client Credentials (for automatic token refresh)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 6. OFFICIAL SOCIAL MEDIA APIS — META, YOUTUBE & TIKTOK (Publishing & Analytics)
# ------------------------------------------------------------------------------
# Meta for Developers (Facebook Graph API & Instagram Content Publishing)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# TikTok Creator/Business App Key (Optional)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 7. AI CONTENT STUDIO & GROWTH INTELLIGENCE — OPENAI & GEMINI (Provider-Independent)
# ------------------------------------------------------------------------------
# OpenAI API Key (starts with sk-..., from https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (alternative AI provider, from https://aistudio.google.com)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 8. SERP & BACKLINK PROVIDERS — DATAFORSEO & SERPAPI (Optional)
# ------------------------------------------------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_API_KEY=

# ------------------------------------------------------------------------------
# 9. SMMFOLLOWS SOCIAL MARKETING API (Server-side only)
# ------------------------------------------------------------------------------
SMMFOLLOWS_API_KEY=

# ------------------------------------------------------------------------------
# 10. PAYMENTLY ONLINE PAYMENT GATEWAY (Optional - BDT)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PAYMENTLY_URL=https://vartualtutor.paymently.io/paymentlink/default/BDT
NEXT_PUBLIC_BDT_PER_USD=125
