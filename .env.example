# NexusMark CRM Environment Configuration
# Duplicate this file to .env.local and populate with your Supabase project credentials.

# Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon API Key (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Supabase Service Role Key (Server-only for admin migrations / tests)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Application base URL (used for auth redirect callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
